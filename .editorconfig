# Clojure is two-space indented by convention, and the babashka entry scripts
# here follow it. Without this section eclint applies a four-space default and
# reports every idiomatic form as a violation -- including the require-all.clj
# that predates this file.
[*.clj]
indent_style = space
indent_size = 2

# Shell here is two-space indented. Declared rather than left to eclint's
# per-file inference, which read the same continuation line as 4 in one script
# and 2 in another once its surrounding lines changed.
[*.sh]
indent_style = space
indent_size = 2
